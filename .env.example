# Local development environment
#
# Copy this file to `.env` only when a root-level tool needs it. The API reads
# `apps/api/.env` during local development.

POSTGRES_DB=chamnhatban
POSTGRES_USER=chamnhatban
POSTGRES_PASSWORD=chamnhatban_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://chamnhatban:chamnhatban_dev_password@localhost:5432/chamnhatban?schema=public
API_PORT=3333

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production
